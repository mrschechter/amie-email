# PostgreSQL application password; replace this obvious fake value.
DATABASE_PASSWORD=replace-with-a-long-random-postgres-password
# ClickHouse application password; replace this obvious fake value.
CLICKHOUSE_PASSWORD=replace-with-a-long-random-clickhouse-password
# Application encryption/signing key; generate one with: openssl rand -base64 32
SECRET_KEY=replace-with-a-random-base64-secret-key
# Single-tenant dashboard login password; replace this obvious fake value.
PASSWORD=replace-with-a-long-random-dashboard-password
# Initial workspace display name.
WORKSPACE_NAME=Amie
# Enable bootstrap for the first boot only, then set this to false and re-create lite.
BOOTSTRAP=true
# Public API/dashboard origin used by the browser; the Compose default is this production URL.
DASHBOARD_API_BASE=https://email.tryamie.com
# Last-click revenue attribution lookback window.
AMIE_ATTRIBUTION_WINDOW_DAYS=5
# S3 bucket name required by backup.sh; also place this value in /etc/dittofeed-backup.env.
BACKUP_S3_BUCKET=replace-with-the-backup-bucket-name
